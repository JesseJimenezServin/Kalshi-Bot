[Unit]
Description=Off-box backup of the kalshi-bot database to B2
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Separate from the market maker's backup in every path it writes:
#  - remote folder kalshi-bot/ in the same bucket (never mixed with the market maker's files)
#  - its own staging dir and success marker (the market maker's healthcheck reads the market maker's)
Environment=DB_PATH=/root/kalshi_bot/data/kalshi_bot.sqlite
Environment=RCLONE_REMOTE=offbox:kalshi-db-backups-prod/kalshi-bot
Environment=STAGING_DIR=/var/tmp/kalshi-bot
Environment=OFFBOX_MARKER=/var/lib/kalshi-bot-offbox/last-success
ExecStartPre=/bin/mkdir -p /var/tmp/kalshi-bot
ExecStart=/root/kalshi_bot/deploy/push_offbox_backup.sh
Nice=15
IOSchedulingClass=idle
