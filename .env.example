# Copy to .env (gitignored) and fill in. Never commit the real file.
KALSHI_API_KEY_ID=
# Path to the private key file (Ed25519 or RSA PEM). Keep it outside the
# project directory, e.g. ~/.kalshi/kalshi_bot_prod.pem, chmod 600.
KALSHI_PRIVATE_KEY_PATH=
# Must be exactly "yes" for mode: live to start. Anything else refuses.
CONFIRM_LIVE_TRADING=no
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
